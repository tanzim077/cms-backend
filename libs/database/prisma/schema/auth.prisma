model Auth {
  id             Int       @id @default(autoincrement())
  access_tokens  String[]  @default([])
  refresh_tokens String[]  @default([])
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user    User @relation(fields: [user_id], references: [id])
  user_id Int  @unique
}
