model Module {
  id                           Int      @id @default(autoincrement())
  title                        String
  objectives                   String
  description                  String
  serial_no                    Int
  logo                         String
  rating                       Float    @default(0)
  batch                        Int
  level                        String
  category                     String
  is_locked_on_date            Boolean  @default(false)
  is_locked_on_previous_module Boolean  @default(false)
  unlocked_on_date             DateTime
  is_published                 Boolean  @default(false)
  completed_students           Int      @default(0)

  courseId Int
  Course   Course  @relation(fields: [courseId], references: [id])
  class    Class[]
}
