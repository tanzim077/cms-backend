model UserRole {
  id        Int      @id @default(autoincrement())
  user_id   Int      @unique
  role_id   Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])

  role Role @relation(fields: [role_id], references: [id])
}
