model Permission {
  id           Int                            @id @default(autoincrement())
  title        String
  description  String?
  code         String                         @unique
  level        Int                            @default(1)
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt
  allowedBy    RolesOnAllowedPermissions[]
  restrictedBy RolesOnRestrictedPermissions[]
}
