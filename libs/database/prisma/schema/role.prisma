model Role {
  id          Int      @id @default(autoincrement())
  name        RoleEnum @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles      UserRole[]
  RolePermission RolePermission[]
}

enum RoleEnum {
  ADMIN
  MODERATOR
  INSTRUCTOR
  STUDENT
  USER
  VIEWER
}
