model Role {
  id          Int      @id @default(autoincrement())
  name        RoleEnum @unique
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Allowed permissions via join table
  allowedPermissions RoleAllowedPermission[]

  // Restricted permissions via join table
  restrictedPermissions RoleRestrictedPermission[]

  userRoles UserRole[]
}

enum RoleEnum {
  ADMIN
  MODERATOR
  INSTRUCTOR
  STUDENT
  USER
  VIEWER
}
