model Auth {
  id             Int       @id @default(autoincrement())
  user_id        Int       @unique
  access_tokens  String[]  @default([])
  refresh_tokens String[]  @default([])
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id])
}
